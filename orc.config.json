{
  "vaultDir": "vault",
  "adapter": "claude-agent-sdk",
  "auth": "subscription",
  "fakeScript": "orc.fake.json",
  "planner": {
    "model": "claude-opus-5-5"
  },
  "coder": {
    "model": "claude-sonnet-5-5"
  },
  "driver": {
    "model": "claude-haiku-5-5"
  },
  "maxBudgetUsd": 20,
  "limits": {
    "maxTurnsTotal": 200,
    "maxSessions": 4,
    "maxWallClockMinutes": 240,
    "concurrency": 2,
    "maxTurnsPerCall": 40,
    "onUsageLimit": "exit"
  },
  "retries": {
    "maxPerTask": 2,
    "onExhausted": "defer"
  },
  "review": {
    "enabled": true,
    "model": "claude-sonnet-5-5",
    "maxFixes": 1
  },
  "coordinator": {
    "enabled": true,
    "model": "claude-sonnet-5-5"
  },
  "verify": {
    "command": "",
    "timeoutMs": 120000
  },
  "checks": [
    {
      "name": "install",
      "command": "test ! -f package.json || npm install --no-audit --no-fund",
      "timeoutMs": 600000
    },
    {
      "name": "typecheck",
      "command": "npm run typecheck",
      "timeoutMs": 600000
    },
    {
      "name": "lint",
      "command": "npm run lint",
      "timeoutMs": 600000
    },
    {
      "name": "test",
      "command": "npm test",
      "timeoutMs": 600000
    },
    {
      "name": "build",
      "command": "npm run build",
      "timeoutMs": 600000
    }
  ],
  "installCommand": "npm install --no-audit --no-fund",
  "summaryBudgetUsd": 0.25
}
